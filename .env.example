# Скопируй этот файл в .env.local и заполни своими значениями

# Google Gemini API (получи на https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Опционально: модели
GEMINI_FAST_MODEL=gemini-flash-latest
GEMINI_MAIN_MODEL=gemini-flash-latest
# Модель для важных и эмоциональных разговоров (если недоступна — откат на gemini-3.5-flash, потом на основную)
GEMINI_SMART_MODEL=gemini-3.8-flash
# Рисование снов — бесплатно через Cloudflare Workers AI (~170 картинок в день на тарифе Workers Free)
# dash.cloudflare.com → Account ID справа на главной; токен: My Profile → API Tokens → шаблон "Workers AI"
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Платная альтернатива (Gemini, ~$0.034 за картинку). Используется, только если Cloudflare не настроен
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Vercel KV (создай в Vercel Dashboard -> Storage -> KV)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# Vercel Postgres (создай в Vercel Dashboard -> Storage -> Postgres)
POSTGRES_URL=

# Защита Cron jobs (придумай любую длинную строку, минимум 32 символа)
CRON_SECRET=

# Push-уведомления. Сгенерировать: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
